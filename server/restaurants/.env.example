# Copy this file to .env and fill in real values.
# Locally: point at your local Postgres.
# On AWS: point at your RDS endpoint (from the RDS console, "Connectivity & security" tab).

PORT=4000

# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/restaurant_service

# Comma-separated list of origins allowed to call this API (your frontend URL, teammates' EC2 URLs)
ALLOWED_ORIGINS=http://localhost:5173
