PORT=8002
DATABASE_URL=postgres://postgres:postgres@localhost:5432/reservations

# Restaurant service base URL used to verify that a restaurant exists/open.
RESTAURANT_SERVICE_URL=http://localhost:8001

# Payment is simulated locally. This controls the default deposit per guest.
DEPOSIT_PER_GUEST_CENTS=500
PAYMENT_CURRENCY=INR

# Optional SNS notification. If omitted, confirmations are saved and SNS is skipped.
AWS_REGION=us-east-1
SNS_TOPIC_ARN=

ALLOWED_ORIGINS=*
